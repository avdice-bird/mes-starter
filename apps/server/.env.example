# SQLite 数据库文件（相对 prisma 目录）
DATABASE_URL="file:./dev.db"
# 第 2 节认证用；必须来自环境变量，禁止写死在代码里
JWT_SECRET="change-me-in-local-env"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"
PORT=3000
# CORS 白名单（逗号分隔）：Web 管理端 5173 + 移动端 H5 5174
WEB_ORIGIN="http://localhost:5173,http://localhost:5174"
# 工厂时区：班次判断、日报按天拆分都用它（第 24、47 节）
FACTORY_TZ="Asia/Shanghai"
# 第 56 节 LLM 功能（OpenAI 兼容接口）
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
